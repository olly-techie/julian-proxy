# Copy to .env and adjust. julian-proxy does not read .env automatically —
# export these in your shell, or use your process manager / container runtime.

# Fallback API key, used only when a request arrives without an
# Authorization header. Prefer passing Authorization per request where you can.
OKEYMETA_API_KEY=okeymeta-your-key-here

# Address and port to listen on.
# Use 0.0.0.0 to accept connections from other machines (containers, LAN).
JULIAN_PROXY_HOST=127.0.0.1
JULIAN_PROXY_PORT=8788

# Upstream OkeyMeta base URL. Point elsewhere to test against a mock.
JULIAN_PROXY_UPSTREAM=https://api.okeymeta.com.ng/v1

# Timeouts in milliseconds. The streaming timeout has to outlast a slow
# generation, since tokens trickle in rather than arriving in one burst.
JULIAN_PROXY_TIMEOUT=20000
JULIAN_PROXY_STREAM_TIMEOUT=120000

# Retry policy for connection failures and upstream 429 rate limits.
JULIAN_PROXY_MAX_ATTEMPTS=3
JULIAN_PROXY_RETRY_BACKOFF=500

# Where the CLI writes its PID file and log when running detached.
# Defaults to $XDG_STATE_HOME/julian-proxy (~/.local/state/julian-proxy on Linux).
# JULIAN_PROXY_STATE_DIR=/home/you/.local/state/julian-proxy
# JULIAN_PROXY_PID_FILE=/home/you/.local/state/julian-proxy/julian-proxy.pid
# JULIAN_PROXY_LOG_FILE=/home/you/.local/state/julian-proxy/julian-proxy.log
